# apps/api/.env — sao chép file này thành .env rồi đổi giá trị.
DATABASE_URL="mysql://root:kitfix@localhost:3307/kitfix247"
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Ký JWT cho /admin — chuỗi ngẫu nhiên ≥ 32 ký tự (vd: openssl rand -hex 32). Bắt buộc đổi khi deploy.
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef

# Tài khoản quản trị do `pnpm db:seed` tạo / cập nhật (mật khẩu lưu bằng bcrypt).
# Chỉ dùng cho máy dev — đổi trước khi deploy.
ADMIN_EMAIL=admin@kitfix247.local
ADMIN_PASSWORD=KitFix247-dev-2026

# File tải lên (logo hãng, ảnh bài viết) — bản local; sau này thay bằng S3/Azure.
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_URL=http://localhost:4000/uploads
