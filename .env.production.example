# Đặt trên VPS thành .env.production rồi đổi TẤT CẢ giá trị. Không commit file thật.

# Image trên Oracle Container Registry: <region>.ocir.io/<tenancy-namespace>/kitfix247
REGISTRY=sin.ocir.io/namespace-cua-ban/kitfix247
# Tag do scripts/push-images.sh in ra (vd 20261019-1430); để latest = bản đẩy gần nhất
TAG=latest

# Tên miền đã trỏ bản ghi A (và www) về IP public của VPS
DOMAIN=kitfix247.com

# MySQL (chỉ chạy trong mạng nội bộ Docker, không mở cổng ra ngoài)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Ký JWT cho /admin — tạo bằng: openssl rand -hex 32
JWT_SECRET=

# Tài khoản quản trị tạo ở lần seed đầu tiên
ADMIN_EMAIL=admin@kitfix247.com
ADMIN_PASSWORD=
