{
  "name": "kitfix247",
  "private": true,
  "packageManager": "pnpm@8.6.12",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm build:packages && pnpm --filter \"./apps/*\" build",
    "test": "pnpm build:packages && pnpm -r test",
    "lint": "pnpm build:packages && pnpm -r lint",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "pnpm --filter @kitfix/api db:migrate",
    "db:seed": "pnpm build:packages && pnpm --filter @kitfix/api db:seed"
  }
}
